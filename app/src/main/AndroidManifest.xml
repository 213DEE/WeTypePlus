<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used by the "restart WeType" action; a normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!--
      Android 11+ package visibility: a package not listed here is invisible to PackageManager,
      which is indistinguishable from "not installed". These three are the ones the diagnostics
      screen has to name - the host, and the framework managers it knows how to look for.
    -->
    <queries>
        <package android:name="com.tencent.wetype" />
        <package android:name="org.lsposed.manager" />
        <package android:name="io.github.lsposed.manager" />
    </queries>

    <!--
      Note for anyone tempted to reach for `android:forceQueryable` here: it does not help. It
      governs PackageManager lookups, not the provider authority resolution that decides whether
      the host's `contentResolver.call` can find this app at all - tried on Android 16, still
      "Unknown authority". Reaching across the process boundary is done with broadcasts instead:
      an intent that names its destination needs no resolution, and therefore no visibility. See
      `SettingsBridge`.
    -->
    <application
        android:allowBackup="true"
        android:description="@string/xposed_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeTypePlus">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The half of the cross-process channel that lives in this app's process: the module's
          status reports arrive here, and the host's request for the switches is answered here.
          Addressed by explicit component from inside WeType, which is the only shape that survives
          package-visibility filtering when the sender is another app.

          It is exported because the sender is a different app, and there is deliberately no
          intent filter: without one, only a sender that already knows this class name can reach
          it, which is as narrow as an exported receiver gets. What will arrive is a status report
          and a settings request; both are bounded to two booleans and display-only text, and
          neither can change how the module behaves beyond the switches the user set the last time
          this app ran.
        -->
        <receiver
            android:name=".bridge.BridgeReceiver"
            android:exported="true" />

        <!--
          Carries the settings across the process boundary for any caller that can reach it. The
          keyboard hooks run inside WeType's process and cannot read this app's private
          preferences directly, but they do *not* depend on this provider: measured on Android 16,
          the host's provider resolution fails with "Unknown authority". Kept because it costs
          nothing and answers correctly for callers that are not affected by the host's package
          visibility - it exposes two booleans and nothing else.
        -->
        <provider
            android:name=".bridge.SettingsProvider"
            android:authorities="cn.dsr213.wetypeplus.settings"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
